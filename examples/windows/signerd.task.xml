<?xml version="1.0" encoding="UTF-8"?>
<!--
  golift/codesign Task Scheduler job for Windows operators who keep the
  YubiKey on the box. Import as a logon task for the user who can see the
  token (InteractiveToken), not a Session-0 Windows Service.

  Edit Command and Arguments, then:

    schtasks /create /tn signerd /xml C:\ProgramData\signerd\signerd.task.xml

  Config: C:\ProgramData\signerd\signerd.toml
  See docs/windows.md.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <URI>\signerd</URI>
    <Description>Remote Authenticode signing daemon (golift.io/codesign)</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\signerd\signerd.exe</Command>
      <Arguments>--config C:\ProgramData\signerd\signerd.toml</Arguments>
    </Exec>
  </Actions>
</Task>
